# Built binaries
/comrade
/comrade.exe
/dist/

# npm distribution: assembled, ready-to-publish package directories are a
# build artifact of scripts/build-npm-packages.sh (from goreleaser's
# dist/ output + a version) -- never hand-edited, never committed. Any
# node_modules would only ever appear here transiently during ad-hoc
# local testing -- the committed npm/ tree has no dependencies of its own.
/npm/packages/
node_modules/

# CI-generated SBOMs (release.yml's anchore/sbom-action step writes its
# output to $RUNNER_TEMP, outside this workspace, specifically to avoid
# this — but this pattern is a belt-and-suspenders guard: if that step's
# output-file ever gets pointed back into the repo, an untracked SBOM
# file here would make `git status --porcelain` report "dirty" and fail
# goreleaser's git-state check before the release even starts, exactly
# as happened in the v0.1.0 tag's first (failed) run.
/sbom-*.cdx.json

# Coverage
*.out
coverage.txt
coverage.html

# snapcraft local build output (snap/snapcraft.yaml drives this; these
# are the standard snapcraft build-cache/output dirs, never sources)
/parts/
/prime/
/stage/
*.snap
.snapcraft/

# OS cruft
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/

# Local scratch state (never versioned)
.remember/
.claude/

# Playwright MCP browser console/page logs, dropped into the repo CWD
# when Playwright is driven from here (e.g. noVNC-based macOS QA) —
# tooling scratch, never a source.
.playwright-mcp/
